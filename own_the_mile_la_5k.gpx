<metadata><name>Pier to Rose — Los Angeles (5K option)</name><desc>DRAFT hand-plotted route for design layout. Not an official Nike route. Verify on the ground before print.</desc></metadata>
<wpt lat="34.01" lon="-118.4965"><name>Start: Santa Monica Pier, beach path on the south side of the pier. Head south on the Marvin Braude beach path (ocean on your right)</name></wpt>
<wpt lat="34.008" lon="-118.4945"><name>Original Muscle Beach</name></wpt>
<wpt lat="34.005" lon="-118.4915"><name>Bay Street beach</name></wpt>
<wpt lat="34.002" lon="-118.4885"><name>Pico-Kenter / Crescent Bay Park</name></wpt>
<wpt lat="33.9995" lon="-118.486"><name>Ocean Park Blvd</name></wpt>
<wpt lat="33.9975" lon="-118.484"><name>Ashland Ave</name></wpt>
<wpt lat="33.995" lon="-118.4815"><name>Navy St (Santa Monica / Venice line)</name></wpt>
<wpt lat="33.9935" lon="-118.48"><name>Rose Ave, start of the Venice Boardwalk. Turn around</name></wpt>
<wpt lat="33.995" lon="-118.4815"><name>Return: Navy St (Santa Monica / Venice line)</name></wpt>
<wpt lat="33.9975" lon="-118.484"><name>Return: Ashland Ave</name></wpt>
<wpt lat="33.9995" lon="-118.486"><name>Return: Ocean Park Blvd</name></wpt>
<wpt lat="34.002" lon="-118.4885"><name>Return: Pico-Kenter / Crescent Bay Park</name></wpt>
<wpt lat="34.005" lon="-118.4915"><name>Return: Bay Street beach</name></wpt>
<wpt lat="34.008" lon="-118.4945"><name>Return: Original Muscle Beach</name></wpt>
<wpt lat="34.01" lon="-118.4965"><name>Finish: Santa Monica Pier</name></wpt>
